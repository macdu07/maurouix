---
import '../../styles/global.css';
import Header from '../../components/Header.astro';
import ProjectActions from '../../components/ProjectActions.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { visibleProjects } from '../../data/projects';
import type { Project } from '../../data/projects';
import { ClientRouter } from 'astro:transitions';

export function getStaticPaths() {
  return visibleProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentIndex = visibleProjects.findIndex((p) => p.slug === project.slug);
const prevProject = currentIndex > 0 ? visibleProjects[currentIndex - 1] : null;
const nextProject = currentIndex < visibleProjects.length - 1 ? visibleProjects[currentIndex + 1] : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={project.description} />
    <title>{project.title} · MauroUIX</title>
    <link rel="canonical" href={`https://maurouix.com/proyectos/${project.slug}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />

    <!-- Open Graph -->
    <meta property="og:title" content={`${project.title} — MauroUIX`} />
    <meta property="og:description" content={project.description} />
    <meta property="og:url" content={`https://maurouix.com/proyectos/${project.slug}`} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="MauroUIX" />
    <meta property="og:image" content="https://maurouix.com/og-image.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${project.title} — MauroUIX`} />
    <meta name="twitter:description" content={project.description} />
    <meta name="twitter:image" content="https://maurouix.com/og-image.jpg" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://maurouix.com" },
            { "@type": "ListItem", "position": 2, "name": "Proyectos", "item": "https://maurouix.com/#work" },
            { "@type": "ListItem", "position": 3, "name": project.title }
          ]
        },
        {
          "@type": "CreativeWork",
          "name": project.title,
          "description": project.overview || project.description,
          "url": `https://maurouix.com/proyectos/${project.slug}`,
          "author": { "@id": "https://maurouix.com/#person" },
          ...(project.year ? { "dateCreated": project.year } : {}),
          ...(project.url ? { "about": { "@type": "WebSite", "url": project.url } } : {}),
          "keywords": project.tags.join(", "),
          "inLanguage": "es"
        }
      ]
    })} />
    <ClientRouter />
    <!-- Microsoft Clarity -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "way9bkhjv4");
    </script>
  </head>
  <body>
    <a href="#project-content" class="skip-link">Saltar al contenido</a>
    <div class="grid-bg" id="grid-bg" aria-hidden="true"></div>

    <Header />

    <main id="project-content">
      <!-- ── Hero editorial del proyecto ── -->
      <section class="case-hero section-pad relative z-10">
        <a href="/#work" class="case-back reveal-up">Volver al portafolio</a>

        <div class="case-hero__heading">
          <div class="reveal-up">
            <span class="case-number">{project.num}</span>
            <h1>{project.title}</h1>
          </div>
          <div class="case-hero__meta reveal-up">
            <p>{project.meta}</p>
            {project.year && <p>{project.year}</p>}
            <ProjectActions
              slug={project.slug}
              title={project.title}
              url={project.url}
              figma={project.figma}
              showCaseLink={false}
            />
          </div>
        </div>

        {project.cover && (
          <div class="case-hero__media reveal-media" data-parallax-media>
            <ProjectMedia
              media={project.cover}
              priority
              showCaption={false}
              sizes="100vw"
            />
          </div>
        )}
      </section>

      <div class="section-divider"></div>

      <!-- ── Tags ── -->
      <section class="pad-x py-10 relative z-10">
        <div class="flex flex-wrap gap-2 reveal-up">
          {project.tags.map((tag) => (
            <span class="tag-pill font-mono text-[0.65rem] tracking-[0.1em] uppercase px-3 py-1">
              {tag}
            </span>
          ))}
        </div>
      </section>

      <div class="section-divider"></div>

      <!-- ── Overview ── -->
      {project.overview && (
        <section class="case-copy section-pad relative z-10">
          <h2 class="section-label reveal-up">Proyecto</h2>
          <p class="case-copy__lead reveal-up">
            {project.overview}
          </p>
        </section>
      )}

      <!-- ── Challenge ── -->
      {project.challenge && (
        <>
          <div class="section-divider"></div>
          <section class="case-copy case-copy--offset section-pad relative z-10">
            <h2 class="section-label reveal-up">Desafío</h2>
            <p class="case-copy__lead reveal-up">
              {project.challenge}
            </p>
          </section>
        </>
      )}

      <!-- ── Features ── -->
      {project.features && project.features.length > 0 && (
        <>
          <div class="section-divider"></div>
          <section class="case-features section-pad relative z-10">
            <h2 class="section-label reveal-up">Lo que construimos</h2>
            <ul class="list-none mt-0 max-w-[65ch] space-y-0">
              {project.features.map((feature) => (
                <li class="feature-item reveal-up">
                  <span class="font-body text-base md:text-lg leading-relaxed text-[var(--color-fg)]">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        </>
      )}

      {project.gallery && project.gallery.length > 0 && (
        <>
          <div class="section-divider"></div>
          <section class="case-gallery section-pad relative z-10" aria-labelledby="gallery-title">
            <div class="case-gallery__heading reveal-up">
              <p class="section-label">Vista del proyecto</p>
              <h2 id="gallery-title">Diseñado para cada pantalla.</h2>
            </div>
            <div class="case-gallery__grid">
              {project.gallery.map((media) => (
                <ProjectMedia
                  media={media}
                  class={`reveal-media ${media.variant === 'mobile' ? 'case-gallery__mobile' : 'case-gallery__wide'}`}
                  sizes={media.variant === 'mobile' ? '(min-width: 1024px) 30vw, 86vw' : '(min-width: 1024px) 80vw, 94vw'}
                />
              ))}
            </div>
          </section>
        </>
      )}

      <div class="section-divider"></div>

      <!-- ── CTA ── -->
      <section class="case-cta section-pad relative z-10">
        <div class="case-cta__inner">
          <div class="reveal-up">
            <p class="section-label">¿Tienes un proyecto similar?</p>
            <h2>Hablemos.<br/><span>Hagámoslo realidad.</span></h2>
          </div>
          <div class="project-actions reveal-up">
            <a href="mailto:contacto@maurouix.com" class="button button--primary">Escríbeme</a>
            <a href="https://wa.me/573023725631" target="_blank" rel="noopener noreferrer" class="button button--secondary">
              WhatsApp<span class="sr-only">, abre en otra pestaña</span>
            </a>
          </div>
        </div>
      </section>

      <div class="section-divider"></div>

      <!-- ── Navegación entre proyectos ── -->
      <nav class="pad-x py-12 relative z-10">
        <div class="flex justify-between items-center">
          <div class="reveal-up">
            {prevProject ? (
              <a href={`/proyectos/${prevProject.slug}`} class="project-nav-link group">
                <span class="font-mono text-[0.65rem] tracking-[0.2em] uppercase text-[var(--color-muted)] block mb-2">
                  Proyecto anterior
                </span>
                <span class="font-display font-semibold text-[clamp(1.2rem,2vw,1.8rem)] group-hover:text-[var(--color-accent)] transition-colors duration-300">
                  {prevProject.title}
                </span>
              </a>
            ) : (
              <span></span>
            )}
          </div>

          <div class="text-right reveal-up">
            {nextProject ? (
              <a href={`/proyectos/${nextProject.slug}`} class="project-nav-link group">
                <span class="font-mono text-[0.65rem] tracking-[0.2em] uppercase text-[var(--color-muted)] block mb-2">
                  Proyecto siguiente
                </span>
                <span class="font-display font-semibold text-[clamp(1.2rem,2vw,1.8rem)] group-hover:text-[var(--color-accent)] transition-colors duration-300">
                  {nextProject.title}
                </span>
              </a>
            ) : (
              <a href="/#work" class="project-nav-link group">
                <span class="font-mono text-[0.65rem] tracking-[0.2em] uppercase text-[var(--color-muted)] block mb-2">
                  Ver todos los proyectos
                </span>
                <span class="font-display font-semibold text-[clamp(1.2rem,2vw,1.8rem)] group-hover:text-[var(--color-accent)] transition-colors duration-300">
                  Portfolio
                </span>
              </a>
            )}
          </div>
        </div>
      </nav>

      <!-- ── Footer mínimo ── -->
      <footer class="pad-x pad-y-sm border-t border-[var(--color-border)] relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 py-6">
          <span class="font-mono text-[0.65rem] tracking-[0.15em] uppercase text-[var(--color-muted)]">
            © 2026 MauroUIX
          </span>
          <a href="/" class="font-display font-semibold text-xl text-[var(--color-accent)] hover:text-[var(--color-fg)] transition-colors duration-300">
            MAUROUIX
          </a>
        </div>
      </footer>
    </main>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // ─── View Transition lifecycle (set up once per browser session) ───
      if (!(window as any).__transitionsInit) {
        (window as any).__transitionsInit = true;

        document.addEventListener('astro:before-preparation', (e: any) => {
          const from: string = e.from.pathname;
          const to: string = e.to.pathname;
          const backward = from.startsWith('/proyectos/') && !to.startsWith('/proyectos/');
          document.documentElement.dataset.direction = backward ? 'backward' : 'forward';
        });

        document.addEventListener('astro:before-swap', () => {
          ScrollTrigger.getAll().forEach((t) => t.kill());
        });
      }

      function initAmbientMotion() {
        const gridBg = document.getElementById('grid-bg');
        if (!gridBg) return;

        const previousHandler = (window as any).__ambientPointerHandler;
        if (previousHandler) window.removeEventListener('pointermove', previousHandler);
        const pointerHandler = (event: PointerEvent) => {
          const x = (event.clientX / window.innerWidth - 0.5) * 14;
          const y = (event.clientY / window.innerHeight - 0.5) * 14;
          gsap.to(gridBg, {
            x,
            y,
            duration: 1.8,
            ease: 'power3.out',
          });
        };
        (window as any).__ambientPointerHandler = pointerHandler;
        window.addEventListener('pointermove', pointerHandler, { passive: true });

        document.querySelectorAll<HTMLElement>('[data-parallax-media]').forEach((media) => {
          gsap.to(media.querySelector('img'), {
            yPercent: 5,
            ease: 'none',
            scrollTrigger: { trigger: media, start: 'top bottom', end: 'bottom top', scrub: 1.1 },
          });
        });
      }

      // ─── Page initialization (runs after every navigation) ───
      document.addEventListener('astro:page-load', () => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!reducedMotion) {
          initAmbientMotion();

          // Scroll reveals
          gsap.utils.toArray<HTMLElement>('.reveal-up').forEach((el) => {
            gsap.fromTo(
              el,
              { opacity: 0, y: 30 },
              {
                opacity: 1,
                y: 0,
                duration: 0.8,
                ease: 'power2.out',
                scrollTrigger: {
                  trigger: el,
                  start: 'top 88%',
                  toggleActions: 'play none none none',
                },
              }
            );
          });

          gsap.utils.toArray<HTMLElement>('.reveal-media').forEach((el) => {
            gsap.fromTo(el,
              { clipPath: 'inset(9% 0 9% 0)', opacity: 0.78, y: 24 },
              {
                clipPath: 'inset(0% 0 0% 0)', opacity: 1, y: 0, duration: 0.9, ease: 'power3.out',
                scrollTrigger: { trigger: el, start: 'top 86%', toggleActions: 'play none none none' },
              }
            );
          });
        } else {
          document.querySelectorAll('.reveal-up, .reveal-media').forEach((el) => {
            gsap.set(el, { opacity: 1, y: 0 });
          });
        }

      });
    </script>
  </body>
</html>
