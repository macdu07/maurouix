---
import { siteContact } from '../data/site';
---

<section id="contact" class="contact-canvas section-pad relative z-10 pb-24" data-scene="contact">
  <div class="contact-canvas__topline reveal-up">
    <span>04 / CONTACTO</span>
    <span>Hagamos algo propio</span>
  </div>

  <div class="contact-canvas__headline reveal-up">
    <h2>Colaboremos<span>.</span></h2>
    <p>Una buena idea merece una experiencia digital que se sienta propia, clara y lista para crecer.</p>
  </div>

  <div class="contact-canvas__details reveal-up">
    <div class="contact-channel">
      <span>Email</span>
      <div class="contact-channel__value">
        <a href={`mailto:${siteContact.email}`}>{siteContact.email}</a>
        <button
          id="copy-email-btn"
          class="copy-btn"
          data-email={siteContact.email}
          aria-label="Copiar email"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-label">Copiar</span>
        </button>
      </div>
    </div>

    <div class="contact-channel">
      <span>WhatsApp</span>
      <a href={siteContact.whatsappUrl} target="_blank" rel="noopener noreferrer" class="contact-channel__phone">
        {siteContact.whatsapp}<span class="sr-only">, abre en otra pestaña</span>
      </a>
    </div>

    <div class="contact-channel">
      <span>Social</span>
      <div class="contact-socials">
        {siteContact.socials.map((social) => (
          <a href={social.url} target="_blank" rel="noopener noreferrer">
            {social.label}<span class="sr-only">, abre en otra pestaña</span>
          </a>
        ))}
      </div>
    </div>
  </div>

</section>

<footer class="site-footer pad-x py-8 relative z-10">
  <p>© 2026 MauroUIX — Todos los derechos reservados</p>
  <p>Cada diseño cuenta una historia. ¿Cuál es la tuya?</p>
</footer>
