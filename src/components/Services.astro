---
const services = [
  {
    num: '01',
    title: 'Diseño de Interfaces Web (UI/UX)',
    description: 'Diseño web intuitivo y fácil de usar para una navegación fluida. Interfaces que equilibran estética y funcionalidad.'
  },
  {
    num: '02',
    title: 'Desarrollo de Sitios Web Creativos',
    description: 'Diseños modernos y únicos que hacen destacar tu marca. Desarrollo con las mejores herramientas del mercado.'
  },
  {
    num: '03',
    title: 'Conceptualización de Imagen Corporativa',
    description: 'Soluciones personalizadas que reflejan la identidad y valores del cliente. Desde el logotipo hasta la presencia digital completa.'
  }
];
---

<section id="services" class="services-canvas section-pad relative z-10" data-scene="services">
  <div class="services-canvas__heading reveal-up">
    <div>
      <span class="services-canvas__index">02 / CAPACIDADES</span>
      <h2>Una idea. Tres formas de hacerla visible.</h2>
    </div>
    <p>
      Tres capacidades conectadas para que una idea conserve su intención desde el primer boceto hasta el sitio publicado.
    </p>
  </div>

  <div class="motion-marquee" aria-hidden="true">
    <div class="motion-marquee__track">
      <div class="motion-marquee__group">
        <span>Diseño</span><i>✳</i><span>Código</span><i>✳</i><span>Dirección</span><i>✳</i>
      </div>
      <div class="motion-marquee__group" aria-hidden="true">
        <span>Diseño</span><i>✳</i><span>Código</span><i>✳</i><span>Dirección</span><i>✳</i>
      </div>
    </div>
  </div>

  <div class="services-canvas__list" data-service-list>
    {services.map((service, index) => (
      <article class={`service-card reveal-up ${index === 0 ? 'is-active' : ''}`} data-service-entry={index}>
        <span class="service-card__number">{service.num}</span>
        <div class="service-card__body">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
        <span class="service-card__arrow" aria-hidden="true">↗</span>
      </article>
    ))}
  </div>
</section>
