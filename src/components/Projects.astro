---
import { visibleProjects } from '../data/projects';
import ProjectActions from './ProjectActions.astro';
import ProjectMedia from './ProjectMedia.astro';
---

<section id="work" class="projects-section section-pad relative z-10">
  <div class="projects-heading">
    <div>
      <p class="section-label eyebrow-rule reveal-up">Portfolio seleccionado</p>
      <h2 class="section-title reveal-up">Proyectos que se pueden explorar.</h2>
    </div>
    <p class="projects-heading__note reveal-up">
      Cada caso conecta el concepto, las decisiones de interfaz y el sitio real. Sin pasos ocultos.
    </p>
  </div>

  <div class="projects-showcase">
    <div class="projects-preview" aria-hidden="true">
      <div class="projects-preview__stage">
        {visibleProjects.map((project, index) => project.cover && (
          <div class={`projects-preview__item ${index === 0 ? 'is-active' : ''}`} data-project-preview={index}>
            <ProjectMedia
              media={project.cover}
              priority={index === 0}
              showCaption={false}
              sizes="(min-width: 1024px) 50vw, 100vw"
            />
            <span class="projects-preview__counter">{project.num} / {String(visibleProjects.length).padStart(2, '0')}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="projects-index" aria-label="Proyectos destacados">
      {visibleProjects.map((project, index) => (
        <article class="project-entry reveal-up" data-project-entry={index}>
          {project.cover && (
            <ProjectMedia
              media={project.cover}
              class="project-entry__media"
              showCaption={false}
              sizes="(max-width: 1023px) 92vw, 1px"
            />
          )}
          <div class="project-entry__topline">
            <span>{project.num}</span>
            <span>{project.meta}</span>
          </div>
          <h3 class="project-entry__title">{project.title}</h3>
          <p class="project-entry__description">{project.description}</p>
          <div class="project-entry__tags" aria-label={`Tecnologías utilizadas en ${project.title}`}>
            {project.tags.slice(0, 4).map((tag) => <span>{tag}</span>)}
          </div>
          <ProjectActions
            slug={project.slug}
            title={project.title}
            url={project.url}
            compact
          />
        </article>
      ))}
    </div>
  </div>

  <aside class="conversion-panel reveal-up" aria-labelledby="conversion-title">
    <div>
      <p class="section-label">El próximo puede ser el tuyo</p>
      <h2 id="conversion-title">¿Tienes un proyecto en mente?</h2>
    </div>
    <p>Conversemos sobre el objetivo, la experiencia y la forma más clara de llevarlo a la web.</p>
    <div class="project-actions">
      <a href="mailto:contacto@maurouix.com" class="button button--light">Escríbeme</a>
      <a href="https://wa.me/573023725631" target="_blank" rel="noopener noreferrer" class="button button--ghost-light">
        WhatsApp<span class="sr-only">, abre en otra pestaña</span>
      </a>
    </div>
  </aside>
</section>
