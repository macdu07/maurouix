---
---

<header id="site-header" class="fixed top-0 left-0 w-full z-50 transition-[background-color,box-shadow] duration-500 border-b border-[var(--color-border)] bg-[rgba(244,239,230,0.82)] backdrop-blur-[14px]">
  <div class="flex items-center justify-between pad-x pad-y-sm">
    <!-- Logo -->
    <div class="flex items-center">
      <a href="/" class="inline-flex items-center text-[var(--color-accent)] no-underline" aria-label="Inicio Mauricio Correa">
        <img src="/brand/logotipo.png" alt="Mauricio Correa — diseñador web y desarrollador UI/UX" class="brand-logo-header" />
      </a>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
      <a href="/#work" class="nav-link">Proyectos</a>
      <a href="/#services" class="nav-link">Servicios</a>
      <a href="/#about" class="nav-link">Sobre Mí</a>
      <a href="/#contact" class="nav-link nav-link--cta">Hablemos</a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="mobile-menu-button md:hidden flex flex-col gap-[5px] bg-transparent border-none cursor-pointer"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-5 h-[1.5px] bg-[var(--color-accent)] transition-transform duration-300"></span>
      <span class="block w-5 h-[1.5px] bg-[var(--color-accent)] transition-transform duration-300"></span>
      <span class="block w-5 h-[1.5px] bg-[var(--color-accent)] transition-transform duration-300"></span>
    </button>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-menu" class="md:hidden overflow-hidden pad-x" aria-hidden="true" hidden>
    <nav class="flex flex-col gap-6 pb-8 pt-2" aria-label="Navegación móvil">
      <a href="/#work" class="nav-link text-base">Proyectos</a>
      <a href="/#services" class="nav-link text-base">Servicios</a>
      <a href="/#about" class="nav-link text-base">Sobre Mí</a>
      <a href="/#contact" class="nav-link nav-link--cta text-base">Hablemos</a>
    </nav>
  </div>

  <div class="site-progress" aria-hidden="true">
    <span id="site-progress-bar" data-progress-bar></span>
  </div>
</header>

<script>
  function registerPageCleanup(cleanup: () => void) {
    const cleanups = ((window as any).__maurouixPageCleanups ||= []) as Array<() => void>;
    cleanups.push(cleanup);
  }

  function initSiteProgress() {
    const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
    if (!bar) return;
    if (bar.dataset.initialized === 'true') {
      window.dispatchEvent(new Event('resize'));
      return;
    }
    const previousCleanup = (window as any).__siteProgressCleanup as (() => void) | undefined;
    previousCleanup?.();
    bar.dataset.initialized = 'true';

    let ticking = false;
    let frameId: number | null = null;
    const update = () => {
      const root = document.documentElement;
      const scrollable = root.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
      ticking = false;
      frameId = null;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      frameId = requestAnimationFrame(update);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
    const cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', update);
      if (frameId !== null) cancelAnimationFrame(frameId);
      if ((window as any).__siteProgressCleanup === cleanup) {
        delete (window as any).__siteProgressCleanup;
      }
    };
    (window as any).__siteProgressCleanup = cleanup;
    registerPageCleanup(cleanup);
  }

  function initSharedMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu || btn.dataset.initialized === 'true') return;
    const previousCleanup = (window as any).__mobileMenuCleanup as (() => void) | undefined;
    previousCleanup?.();
    btn.dataset.initialized = 'true';

    let isOpen = false;
    const openMenu = () => {
      isOpen = true;
      menu.hidden = false;
      menu.style.height = '0px';
      requestAnimationFrame(() => { menu.style.height = menu.scrollHeight + 'px'; });
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Cerrar menú de navegación');
      menu.setAttribute('aria-hidden', 'false');
    };
    const closeMenu = () => {
      isOpen = false;
      menu.style.height = '0px';
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menú de navegación');
      menu.setAttribute('aria-hidden', 'true');
      window.setTimeout(() => { if (!isOpen) menu.hidden = true; }, 520);
    };

    const onButtonClick = () => { isOpen ? closeMenu() : openMenu(); };
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape' && isOpen) {
        closeMenu();
        btn.focus();
      }
    };
    btn.addEventListener('click', onButtonClick);
    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));
    links.forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', onKeyDown);
    const cleanup = () => {
      btn.removeEventListener('click', onButtonClick);
      links.forEach((link) => link.removeEventListener('click', closeMenu));
      document.removeEventListener('keydown', onKeyDown);
      if ((window as any).__mobileMenuCleanup === cleanup) {
        delete (window as any).__mobileMenuCleanup;
      }
    };
    (window as any).__mobileMenuCleanup = cleanup;
    registerPageCleanup(cleanup);
  }

  document.addEventListener('astro:page-load', () => {
    initSiteProgress();
    initSharedMobileMenu();
  });
</script>
